    "Trash button - Start over and discard everything, OR keep selected images and remove all filters, OR keep all effex filters without images " : {
      "comment" : "Help page instructions",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tlačítko Smazat - začněte znovu a zahoďte vše, NEBO zachovejte vybrané obrázky a odstraňte všechny filtry, NEBO zachovejte všechny filtry Effex bez obrázků "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Taste „Löschen“ – Neu beginnen und alles verwerfen, ODER ausgewählte Bilder behalten und alle Filter entfernen, ODER alle Effex-Filter ohne Bilder behalten "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Botón «Eliminar» - Empieza de nuevo y descarta todo, O conserva las imágenes seleccionadas y elimina todos los filtros, O conserva todos los filtros Effex sin imágenes "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bouton « Supprimer » – Recommencez et effacez tout, OU conservez les images sélectionnées et supprimez tous les filtres, OU conservez tous les filtres Effex sans images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pulsante “Elimina”: ricomincia e scarta tutto, OPPURE mantieni le immagini selezionate e rimuovi tutti i filtri, OPPURE mantieni tutti i filtri Effex senza immagini "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“削除”ボタン: 最初からやり直してすべて破棄するか、選択した画像を残してすべてのフィルタを削除するか、または画像なしですべてのEffexフィルタを残します "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Botão “Apagar”: recomece e descarte tudo OU mantenha as imagens selecionadas e remova todos os filtros OU mantenha todos os filtros Effex sem imagens "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“删除”按钮：重新开始并丢弃所有内容，或者保留所选图像并移除所有滤镜，或者保留所有 Effex 滤镜但不保留图像 "
          }
        }
      }
    },
    "Triangle Gradient" : {
