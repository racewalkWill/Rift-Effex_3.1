    "The linked center moves with this center." : {
      "comment" : "action sheet message - link center points",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Propojený střed se pohybuje spolu s tímto středem."
          }
        },
        "de" : {
          "stringUnit" : {
