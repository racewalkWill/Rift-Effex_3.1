    "TAP on Image row - SWIPE to '+Effex' for image from another filter. Or 'Library' for image from saved Library  -->" : {
      "comment" : "Help page instructions",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "KLEPNĚTE na řádek Obrázek - PŘEJETÍM na „+Effex“ zobrazíte obrázek z jiného filtru. Nebo na „Knihovna“ obrázek z uložené knihovny  -->"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TIPPE auf die Bildzeile – STREICHE zu „+Effex“ für ein Bild aus einem anderen Filter. Oder zu „Bibliothek“ für ein Bild aus der gespeicherten Bibliothek  -->"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TOCA la fila Imagen - DESLIZA hacia «+Effex» para obtener una imagen de otro filtro. O hacia «Biblioteca» para obtener una imagen guardada en la biblioteca  -->"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Touchez la ligne Image, puis balayez vers « +Effex » pour une image d’un autre filtre, ou vers « Bibliothèque » pour une image de la bibliothèque enregistrée  -->"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TOCCA la riga Immagine - SCORRI verso “+Effex” per un’immagine da un altro filtro. Oppure verso “Libreria” per un’immagine dalla Libreria salvata  -->"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“画像”の行をタップ - “+Effex”にスワイプすると別のフィルタの画像を、“ライブラリ”にスワイプすると保存済みライブラリの画像を使用できます  -->"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TOQUE na linha Imagem - DESLIZE até “+Effex” para usar uma imagem de outro filtro. Ou até “Biblioteca” para usar uma imagem da Biblioteca salva  -->"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "轻点“图像”行 - 轻扫到“+Effex”以使用另一个滤镜的图像，或轻扫到“资料库”以使用已存储资料库中的图像  -->"
          }
        }
      }
    },
