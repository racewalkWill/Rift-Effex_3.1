    },
    "TAP a row again to highlight and view only the selected filter effex image -->" : {
      "comment" : "Help page instructions",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "KLEPNUTÍM na řádek znovu jej zvýrazníte a zobrazíte pouze obrázek vybraného filtru Effex -->"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TIPPE erneut auf eine Zeile, um sie zu markieren und nur das Effex-Bild des ausgewählten Filters anzuzeigen -->"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "TOCA una fila otra vez para resaltarla y ver solo la imagen Effex del filtro seleccionado -->"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
