    "Type title/album names. TAP 'Save' button saves a copy into Photos. Source images are not changed" : {
      "comment" : "Help page instructions",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Napište název a název alba. KLEPNUTÍM na tlačítko „Uložit“ uložíte kopii do Fotek. Zdrojové obrázky se nezmění"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gib Titel-/Albumnamen ein. Tippen auf die Taste „Sichern“ speichert eine Kopie in Fotos. Die Ausgangsbilder werden nicht verändert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escribe el título y el nombre del álbum. TOCA el botón «Guardar» para guardar una copia en Fotos. Las imágenes de origen no se modifican"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saisissez les noms du titre et de l’album. Touchez le bouton « Enregistrer » pour enregistrer une copie dans Photos. Les images source ne sont pas modifiées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digita il titolo e il nome dell’album. TOCCA il pulsante “Salva” per salvare una copia in Foto. Le immagini originali non vengono modificate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "タイトルとアルバム名を入力します。“保存”ボタンをタップすると、コピーが“写真”に保存されます。元の画像は変更されません"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digite o título e o nome do álbum. TOQUE no botão “Salvar” para salvar uma cópia em Fotos. As imagens originais não são alteradas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "输入标题和相簿名称。轻点“存储”按钮可将拷贝存储到“照片”。源图像不会被更改"
          }
        }
      }
    },
