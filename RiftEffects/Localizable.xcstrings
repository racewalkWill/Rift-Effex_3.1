    "Swipe 'Make' to add random filters. Select photos for random input on Parms 'Library' command" : {
      "comment" : "Random Filters custom filter description. 'Make' and 'Library' are swipe action labels and must match their translations",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Přejetím přes „Vytvořit“ přidáte náhodné filtry. Fotografie jako náhodný vstup vyberete příkazem „Knihovna“ na obrazovce parametrů"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Streiche über „Erstellen“, um Zufallsfilter hinzuzufügen. Wähle Fotos als zufällige Eingabe mit dem Befehl „Bibliothek“ auf dem Parameter-Bildschirm"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desliza «Crear» para agregar filtros aleatorios. Selecciona fotos como entrada aleatoria con el comando «Biblioteca» en la pantalla de parámetros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Balayez « Créer » pour ajouter des filtres aléatoires. Sélectionnez des photos comme entrée aléatoire avec la commande « Bibliothèque » de l’écran des paramètres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scorri su “Crea” per aggiungere filtri casuali. Seleziona le foto da usare come input casuale con il comando “Libreria” dei parametri"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“作成”までスワイプすると、ランダムなフィルタが追加されます。パラメータの“ライブラリ”コマンドで、ランダム入力用の写真を選択します"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deslize até “Criar” para adicionar filtros aleatórios. Selecione fotos como entrada aleatória com o comando “Biblioteca” dos parâmetros"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
