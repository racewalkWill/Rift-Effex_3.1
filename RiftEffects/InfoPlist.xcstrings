    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Přehrávání hudby z vaší knihovny Apple Music jako doprovod k fotografiím"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Musik aus deiner Apple Music-Mediathek als Begleitung zu Fotos wiedergeben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Play music from your Apple Music Library to accompany photos"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reproduce música de tu biblioteca de Apple Music para acompañar las fotos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lire de la musique de votre bibliothèque Apple Music pour accompagner vos photos"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kamera se používá s filtrem VideoCam a její obraz lze zaznamenat pomocí nahrávání obrazovky"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Kamera wird mit dem VideoCam-Filter verwendet und kann mit der Bildschirmaufnahme aufgezeichnet werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Camera is used with the VideoCam filter and can be recorded with Screen Recording"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cámara se usa con el filtro VideoCam y su imagen puede grabarse con la grabación de pantalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La caméra est utilisée avec le filtre VideoCam et son image peut être enregistrée avec l’enregistrement de l’écran"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mikrofon se používá pro vaše zvukové komentáře s filtrem VideoCam během nahrávání obrazovky"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Mikrofon wird für deine Audiokommentare mit dem VideoCam-Filter während der Bildschirmaufnahme verwendet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Microphone is used for your audio comments with VideoCam filter during Screen Recording"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El micrófono se usa para tus comentarios de audio con el filtro VideoCam durante la grabación de pantalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le micro est utilisé pour vos commentaires audio avec le filtre VideoCam pendant l’enregistrement de l’écran"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikace zobrazí vaše fotografie a použije na ně filtry s vizuálními efekty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die App zeigt deine Fotos an und wendet visuelle Effektfilter auf die Anzeige an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The app will display your photos and apply visual effect filters to the display."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La app mostrará tus fotos y aplicará filtros de efectos visuales a la imagen en pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’app affichera vos photos et leur appliquera des filtres d’effets visuels."
          }
        }
      }
    }
  },
  "version" : "1.3"
